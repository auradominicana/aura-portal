# Puerto local (Railway asigna el suyo automáticamente vía PORT)
PORT=4200

# ── SSO ──────────────────────────────────────────────────────────────
# Mismo secreto en los 4 servicios (este + Ventas/CRM AURA + Cobros + Operaciones/Rutero).
# Generar uno nuevo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SSO_SHARED_SECRET=

# Token de los endpoints públicos de score (mismo que ya usa el Rutero para
# /api/solicitudes-facturacion/public). Debe coincidir en los 3 servicios.
OPS_PUBLIC_TOKEN=AURA-COBROS-2026

# ── URLs de los 3 sistemas ───────────────────────────────────────────
CRM_URL=https://crm.aura.com.do
COBROS_URL=https://aura-cobros-production.up.railway.app
RUTERO_URL=https://rutero-aura-production.up.railway.app

# ── Cuenta admin única (Mariel) ──────────────────────────────────────
HUB_ADMIN_EMAIL=mariel@aura.com.do
HUB_ADMIN_NOMBRE=Mariel
# Hash bcrypt de su contraseña — generar con:
#   node -e "console.log(require('bcryptjs').hashSync('TU_CLAVE',10))"
HUB_ADMIN_PASSWORD_HASH=
